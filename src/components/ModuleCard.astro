---
interface Props {
  id: string;
  label: string;
  description?: string; // New description prop
  type: "link" | "modal";
  url?: string;

  target?: string;
  rel?: string;
  modalId?: string;
  icon: string;
  highlight?: string | null;
}

const {
  id,
  label,
  description,
  type,
  url,
  target,
  rel,
  modalId,
  icon,
  highlight,
} = Astro.props;
const highlightClass = highlight ? `highlight-${highlight}` : "";
---

{
  type === "link" ? (
    <a
      href={url}
      target={target || "_self"}
      rel={rel}
      class:list={["module-card", highlightClass]}
      data-id={id}
    >
      <div class="module-icon">
        <i class={icon} />
      </div>
      <span class="module-label">{label}</span>
      {description && <div class="module-tooltip">{description}</div>}
    </a>
  ) : (
    <button
      class:list={["module-card", highlightClass]}
      data-modal-id={modalId}
      data-id={id}
    >
      <div class="module-icon">
        <i class={icon} />
      </div>
      <span class="module-label">{label}</span>
      {description && <div class="module-tooltip">{description}</div>}
    </button>
  )
}

<style>
  .module-card {
    background-color: var(--color-module-bg);
    border-radius: var(--border-radius-md);
    padding: 20px 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    transition: var(--transition-normal);
    text-decoration: none;
    color: var(--color-text-white);
    border: none;
    border: none;
    font-family: inherit;
    position: relative; /* Needed for absolute positioning of tooltip */
  }

  .module-card:hover {
    background-color: var(--color-module-hover);
    transform: translateY(-3px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
  }

  .module-card.highlight-red {
    background-color: var(--color-accent-red);
  }

  .module-card.highlight-red:hover {
    background-color: #b91c1c;
  }

  .module-card.highlight-orange {
    background-color: var(--color-accent-orange);
  }

  .module-card.highlight-orange:hover {
    background-color: #d97706;
  }

  .module-icon {
    width: 45px;
    height: 45px;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .module-icon i {
    font-size: 32px;
    color: var(--color-gold);
  }

  .module-card.highlight-red .module-icon i,
  .module-card.highlight-orange .module-icon i {
    color: var(--color-text-white);
  }

  .module-label {
    font-size: 11px;
    font-weight: 500;
    text-align: center;
    line-height: 1.3;
    word-wrap: break-word;
    max-width: 100%;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .module-card {
      padding: 15px 8px;
      gap: 10px;
    }

    .module-icon {
      width: 35px;
      height: 35px;
    }

    .module-icon i {
      font-size: 24px;
    }

    .module-label {
      font-size: 10px;
    }
  }

  @media (max-width: 576px) {
    .module-card {
      padding: 12px 6px;
      gap: 8px;
    }

    .module-icon {
      width: 30px;
      height: 30px;
    }

    .module-icon i {
      font-size: 20px;
    }

    .module-label {
      font-size: 9px;
    }
  }

  @media (max-width: 400px) {
    .module-card {
      padding: 15px 10px;
    }

    .module-icon {
      width: 35px;
      height: 35px;
    }

    .module-label {
      font-size: 10px;
    }
  }

  /* Tooltip Styles */
  .module-tooltip {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    background-color: var(--color-bg-secondary);
    color: var(--color-text-white);
    padding: 10px;
    border-radius: var(--border-radius-sm);
    border: 1px solid var(--color-gold);
    font-size: 12px;
    width: max-content;
    max-width: 200px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.4);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 20;
    pointer-events: none;
  }

  /* Tooltip arrow */
  .module-tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px;
    border-style: solid;
    border-color: var(--color-gold) transparent transparent transparent;
  }

  .module-card:hover .module-tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-15px);
  }
</style>
