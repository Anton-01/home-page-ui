---
interface CalendarEvent {
  day: number;
  title: string;
  content: string;
  time: string;
  event_date?: string;
  start_time?: string;
  end_time?: string;
}

interface Props {
  events: CalendarEvent[];
  month?: string;
  year?: number;
}

const { events, month, year } = Astro.props;

// Dynamic calendar: use current date
const now = new Date();
const displayMonth =
  month || new Intl.DateTimeFormat("es", { month: "long" }).format(now);
const displayYear = year || now.getFullYear();

// Calculate month/year for date math
const monthNames = [
  "Enero",
  "Febrero",
  "Marzo",
  "Abril",
  "Mayo",
  "Junio",
  "Julio",
  "Agosto",
  "Septiembre",
  "Octubre",
  "Noviembre",
  "Diciembre",
];
const monthIndex = monthNames.findIndex(
  (m) => m.toLowerCase() === displayMonth.toLowerCase(),
);
const calcMonth = monthIndex >= 0 ? monthIndex : now.getMonth();
const calcYear = displayYear;

// First day of month (0=Sun, convert to Mon-based: Mon=0..Sun=6)
const firstDayOfMonth = new Date(calcYear, calcMonth, 1).getDay();
const firstDayOffset = firstDayOfMonth === 0 ? 6 : firstDayOfMonth - 1;

// Days in month
const daysInMonth = new Date(calcYear, calcMonth + 1, 0).getDate();

// Highlight today only if viewing current month
const today = now.getDate();
const isCurrentMonth =
  calcMonth === now.getMonth() && calcYear === now.getFullYear();
const highlightDay = isCurrentMonth ? today : -1;

// Create event lookup map
const eventsMap = new Map<number, CalendarEvent>();
events.forEach((event) => {
  eventsMap.set(event.day, event);
});

// Generate calendar days
const emptyDays = Array(firstDayOffset).fill(null);
const monthDays = Array.from({ length: daysInMonth }, (_, i) => i + 1);
---

<div class="calendar-section">
  <div class="calendar-container">
    <div class="calendar">
      <div class="calendar-header">
        <h2 class="calendar-month">{displayMonth} {displayYear}</h2>
      </div>
      <div class="calendar-weekdays">
        <span class="calendar-weekday">L</span>
        <span class="calendar-weekday">M</span>
        <span class="calendar-weekday">M</span>
        <span class="calendar-weekday">J</span>
        <span class="calendar-weekday">V</span>
        <span class="calendar-weekday">S</span>
        <span class="calendar-weekday">D</span>
      </div>
      <div class="calendar-days" id="calendarDays">
        {emptyDays.map(() => <span class="calendar-day empty" />)}
        {
          monthDays.map((day) => {
            const event = eventsMap.get(day);
            const isToday = day === highlightDay;
            const hasEvent = !!event;

            return (
              <span
                class:list={[
                  "calendar-day",
                  { today: isToday, "has-event": hasEvent },
                ]}
                data-day={day}
                data-event={hasEvent ? JSON.stringify(event) : undefined}
              >
                {day}
              </span>
            );
          })
        }
      </div>
    </div>
  </div>
</div>

<!-- Event Mini Modal -->
<div class="event-modal" id="eventModal">
  <div class="event-modal-header">
    <span class="event-modal-date" id="eventModalDate"></span>
    <button class="event-modal-close" id="closeEventModal">
      <svg viewBox="0 0 24 24"
        ><path
          d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
        ></path></svg
      >
    </button>
  </div>
  <div class="event-modal-body">
    <h3 class="event-modal-title" id="eventModalTitle"></h3>
    <p class="event-modal-content" id="eventModalContent"></p>
    <div class="event-modal-time" id="eventModalTime">
      <svg viewBox="0 0 24 24"
        ><path
          d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"
        ></path></svg
      >
      <span id="eventModalTimeText"></span>
    </div>
    <!-- Add to Calendar -->
    <div class="event-modal-reminder">
      <button class="btn-add-calendar" id="btnAddCalendar" type="button">
        <svg viewBox="0 0 24 24"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"></path></svg>
        Agregar a mi calendario
        <svg class="chevron-icon" viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"></path></svg>
      </button>
      <div class="calendar-dropdown" id="calendarDropdown">
        <button class="calendar-dropdown-item" id="btnGoogleCal" type="button">
          <svg viewBox="0 0 24 24"><path d="M19.5 3h-3V1.5h-1.5V3h-6V1.5H7.5V3h-3C3.675 3 3 3.675 3 4.5v15c0 .825.675 1.5 1.5 1.5h15c.825 0 1.5-.675 1.5-1.5v-15c0-.825-.675-1.5-1.5-1.5zm0 16.5h-15V8.25h15v11.25z" fill="#4285F4"></path></svg>
          Google Calendar
        </button>
        <button class="calendar-dropdown-item" id="btnOutlookCal" type="button">
          <svg viewBox="0 0 24 24"><path d="M21 4H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H3V8h18v10z" fill="#0078D4"></path></svg>
          Outlook Web
        </button>
        <button class="calendar-dropdown-item" id="btnDownloadIcs" type="button">
          <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" fill="#c9a227"></path></svg>
          Descargar .ics
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .calendar-section {
    width: 320px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .calendar-container {
    width: 100%;
  }

  .calendar {
    background-color: var(--color-calendar-bg);
    border-radius: var(--border-radius-lg);
    padding: 25px;
    color: #1e293b;
  }

  .calendar-header {
    text-align: center;
    margin-bottom: 20px;
  }

  .calendar-month {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .calendar-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
    margin-bottom: 10px;
  }

  .calendar-weekday {
    text-align: center;
    font-weight: 600;
    font-size: 14px;
    color: #475569;
    padding: 8px 0;
  }

  .calendar-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 5px;
  }

  .calendar-day {
    text-align: center;
    padding: 10px 5px;
    font-size: 14px;
    font-weight: 500;
    color: #334155;
    border-radius: var(--border-radius-sm);
    cursor: pointer;
    transition: var(--transition-fast);
    position: relative;
  }

  .calendar-day:hover:not(.empty) {
    background-color: #e2e8f0;
  }

  .calendar-day.today {
    background-color: var(--color-gold);
    color: white;
  }

  .calendar-day.empty {
    visibility: hidden;
  }

  .calendar-day.has-event {
    font-weight: 700;
  }

  .calendar-day.has-event::after {
    content: "";
    position: absolute;
    bottom: 4px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    background-color: var(--color-accent-red);
    border-radius: 50%;
  }

  .calendar-day.today.has-event::after {
    background-color: white;
  }

  /* Event Modal */
  .event-modal {
    position: fixed;
    background-color: var(--color-bg-secondary);
    border-radius: var(--border-radius-md);
    padding: 0;
    min-width: 280px;
    max-width: 320px;
    z-index: 1001;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transform: scale(0.9);
    transition: all var(--transition-fast);
  }

  .event-modal.active {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
  }

  .event-modal-header {
    background: linear-gradient(
      135deg,
      var(--color-accent-red) 0%,
      #b91c1c 100%
    );
    padding: 15px 20px;
    border-radius: var(--border-radius-md) var(--border-radius-md) 0 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .event-modal-date {
    font-size: 14px;
    font-weight: 500;
    opacity: 0.9;
    color: white;
  }

  .event-modal-close {
    width: 28px;
    height: 28px;
    background-color: rgba(255, 255, 255, 0.15);
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: var(--transition-fast);
  }

  .event-modal-close:hover {
    background-color: rgba(255, 255, 255, 0.25);
  }

  .event-modal-close svg {
    width: 14px;
    height: 14px;
    fill: white;
  }

  .event-modal-body {
    padding: 20px;
  }

  .event-modal-title {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 10px;
    color: var(--color-gold);
  }

  .event-modal-content {
    font-size: 14px;
    color: var(--color-text-light);
    line-height: 1.6;
  }

  .event-modal-time {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 13px;
    color: var(--color-text-light);
  }

  .event-modal-time svg {
    width: 16px;
    height: 16px;
    fill: var(--color-gold);
  }

  /* Add to Calendar button */
  .event-modal-reminder {
    margin-top: 15px;
    position: relative;
  }

  .btn-add-calendar {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 16px;
    background: linear-gradient(135deg, var(--color-gold, #c9a227) 0%, #b8911f 100%);
    color: white;
    border: none;
    border-radius: var(--border-radius-sm, 6px);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-add-calendar:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(201, 162, 39, 0.3);
  }

  .btn-add-calendar svg {
    width: 16px;
    height: 16px;
    fill: white;
  }

  .btn-add-calendar .chevron-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.2s ease;
  }

  .btn-add-calendar.active .chevron-icon {
    transform: rotate(180deg);
  }

  .calendar-dropdown {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 0;
    right: 0;
    background-color: var(--color-bg-secondary, #1a1a2e);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--border-radius-sm, 6px);
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: all 0.2s ease;
    z-index: 10;
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.3);
  }

  .calendar-dropdown.active {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .calendar-dropdown-item {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: none;
    border: none;
    color: var(--color-text-light, #ccc);
    font-size: 13px;
    cursor: pointer;
    transition: background-color 0.15s ease;
    text-align: left;
  }

  .calendar-dropdown-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: white;
  }

  .calendar-dropdown-item + .calendar-dropdown-item {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .calendar-dropdown-item svg {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .calendar-section {
      width: 280px;
    }
  }

  @media (max-width: 1024px) {
    .calendar-section {
      width: 100%;
      max-width: 400px;
      margin: 0 auto;
    }
  }

  @media (max-width: 576px) {
    .calendar {
      padding: 20px;
    }

    .calendar-month {
      font-size: 1.2rem;
    }

    .calendar-day {
      padding: 8px 3px;
      font-size: 12px;
    }

    .event-modal {
      left: 10px !important;
      right: 10px !important;
      max-width: none;
      min-width: auto;
    }
  }
</style>

<script is:inline>
  // Current event data for calendar export
  var _currentCalEvent = null;

  function initCalendar() {
    var calendarDays = document.querySelectorAll(".calendar-day.has-event");
    var eventModal = document.getElementById("eventModal");
    var closeModalBtn = document.getElementById("closeEventModal");

    calendarDays.forEach(function (day) {
      day.addEventListener("click", function (e) {
        var target = e.target;
        var dayNum = target.getAttribute("data-day");
        var eventData = target.getAttribute("data-event");
        if (eventData && dayNum) {
          var event = JSON.parse(eventData);
          showEventModal(parseInt(dayNum), event, e);
        }
      });
    });

    closeModalBtn?.addEventListener("click", closeEventModal);

    // Add to Calendar dropdown toggle
    var btnAddCal = document.getElementById("btnAddCalendar");
    var dropdown = document.getElementById("calendarDropdown");
    if (btnAddCal && dropdown) {
      btnAddCal.addEventListener("click", function (e) {
        e.stopPropagation();
        var isOpen = dropdown.classList.contains("active");
        dropdown.classList.toggle("active");
        btnAddCal.classList.toggle("active");
        if (isOpen) {
          dropdown.classList.remove("active");
          btnAddCal.classList.remove("active");
        }
      });
    }

    // Calendar export buttons
    var btnGoogle = document.getElementById("btnGoogleCal");
    var btnOutlook = document.getElementById("btnOutlookCal");
    var btnIcs = document.getElementById("btnDownloadIcs");

    if (btnGoogle) btnGoogle.addEventListener("click", function (e) {
      e.stopPropagation();
      if (_currentCalEvent) exportToGoogleCalendar(_currentCalEvent);
    });
    if (btnOutlook) btnOutlook.addEventListener("click", function (e) {
      e.stopPropagation();
      if (_currentCalEvent) exportToOutlookWeb(_currentCalEvent);
    });
    if (btnIcs) btnIcs.addEventListener("click", function (e) {
      e.stopPropagation();
      if (_currentCalEvent) downloadIcsFile(_currentCalEvent);
    });

    // Close on outside click
    document.addEventListener("click", function (e) {
      var target = e.target;
      // Close dropdown if clicking outside
      if (dropdown && dropdown.classList.contains("active")) {
        if (!dropdown.contains(target) && target !== btnAddCal) {
          dropdown.classList.remove("active");
          if (btnAddCal) btnAddCal.classList.remove("active");
        }
      }
      if (eventModal && eventModal.classList.contains("active")) {
        if (
          !eventModal.contains(target) &&
          !target.classList.contains("has-event")
        ) {
          closeEventModal();
        }
      }
    });

    // Close on Escape
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") {
        closeEventModal();
      }
    });
  }

  function showEventModal(day, event, e) {
    var modal = document.getElementById("eventModal");
    if (!modal) return;

    // Store event for calendar export
    _currentCalEvent = event;

    // Close dropdown if open
    var dropdown = document.getElementById("calendarDropdown");
    var btnAddCal = document.getElementById("btnAddCalendar");
    if (dropdown) dropdown.classList.remove("active");
    if (btnAddCal) btnAddCal.classList.remove("active");

    var dateEl = document.getElementById("eventModalDate");
    var titleEl = document.getElementById("eventModalTitle");
    var contentEl = document.getElementById("eventModalContent");
    var timeTextEl = document.getElementById("eventModalTimeText");

    var calMonth = document.querySelector(".calendar-month");
    var monthYearText = calMonth ? calMonth.textContent : "";
    if (dateEl) dateEl.textContent = day + " de " + monthYearText;
    if (titleEl) titleEl.textContent = event.title;
    if (contentEl) contentEl.textContent = event.content;
    if (timeTextEl) timeTextEl.textContent = event.time;

    // Position the modal
    var modalRect = modal.getBoundingClientRect();
    var modalWidth = modalRect.width || 300;
    var modalHeight = modalRect.height || 200;
    var viewportWidth = window.innerWidth;
    var viewportHeight = window.innerHeight;

    var rect = e.target.getBoundingClientRect();

    // Calculate default position (below the date, centered horizontally)
    var top = rect.bottom + 10;
    var left = rect.left + rect.width / 2 - modalWidth / 2;

    // Horizontal collision detection
    if (left < 10) {
      left = 10;
    } else if (left + modalWidth > viewportWidth - 10) {
      left = viewportWidth - modalWidth - 10;
    }

    // Vertical collision detection
    if (top + modalHeight > viewportHeight - 10) {
      if (rect.top - modalHeight - 10 > 10) {
        top = rect.top - modalHeight - 10;
      } else {
        top = rect.top - modalHeight - 10;
      }
    }

    // Final clamp
    if (top < 10) top = 10;
    if (top + modalHeight > viewportHeight)
      top = viewportHeight - modalHeight - 10;

    modal.style.left = left + "px";
    modal.style.top = top + "px";
    modal.classList.add("active");
  }

  function closeEventModal() {
    var modal = document.getElementById("eventModal");
    if (modal) {
      modal.classList.remove("active");
    }
    var dropdown = document.getElementById("calendarDropdown");
    var btnAddCal = document.getElementById("btnAddCalendar");
    if (dropdown) dropdown.classList.remove("active");
    if (btnAddCal) btnAddCal.classList.remove("active");
    _currentCalEvent = null;
  }

  // ============================
  // Calendar Export Functions
  // ============================

  function getEventDateParts(event) {
    // Parse event_date (e.g., "2024-01-15" or "2024-01-15T00:00:00.000Z")
    var dateParts = { year: 0, month: 0, day: 0 };
    if (event.event_date) {
      var d = new Date(event.event_date);
      dateParts.year = d.getFullYear();
      dateParts.month = d.getMonth() + 1;
      dateParts.day = d.getDate();
    } else {
      // Fallback: use current month/year from the calendar header + event.day
      var calMonth = document.querySelector(".calendar-month");
      var text = calMonth ? calMonth.textContent.trim() : "";
      var monthNames = ["enero","febrero","marzo","abril","mayo","junio","julio","agosto","septiembre","octubre","noviembre","diciembre"];
      var parts = text.split(" ");
      var monthStr = (parts[0] || "").toLowerCase();
      var yearStr = parts[1] || new Date().getFullYear();
      var mIdx = monthNames.indexOf(monthStr);
      dateParts.year = parseInt(yearStr, 10);
      dateParts.month = mIdx >= 0 ? mIdx + 1 : (new Date().getMonth() + 1);
      dateParts.day = event.day || 1;
    }
    return dateParts;
  }

  function parseTimeStr(timeStr) {
    // Parse "HH:MM:SS" or "HH:MM" (24h format from backend)
    if (!timeStr) return null;
    var parts = timeStr.split(":");
    return { hours: parseInt(parts[0], 10), minutes: parseInt(parts[1] || "0", 10) };
  }

  function pad2(n) {
    return n < 10 ? "0" + n : "" + n;
  }

  function toIcsDateTime(dateParts, timeParts) {
    // Format: 20240115T130000
    var y = dateParts.year;
    var m = pad2(dateParts.month);
    var d = pad2(dateParts.day);
    if (timeParts) {
      return y + m + d + "T" + pad2(timeParts.hours) + pad2(timeParts.minutes) + "00";
    }
    return y + m + d;
  }

  function toIsoDateTime(dateParts, timeParts) {
    // Format: 2024-01-15T13:00:00
    var y = dateParts.year;
    var m = pad2(dateParts.month);
    var d = pad2(dateParts.day);
    if (timeParts) {
      return y + "-" + m + "-" + d + "T" + pad2(timeParts.hours) + ":" + pad2(timeParts.minutes) + ":00";
    }
    return y + "-" + m + "-" + d;
  }

  function downloadIcsFile(event) {
    var dateParts = getEventDateParts(event);
    var startTime = parseTimeStr(event.start_time);
    var endTime = parseTimeStr(event.end_time);

    var dtStart, dtEnd;
    if (startTime) {
      dtStart = "DTSTART:" + toIcsDateTime(dateParts, startTime);
      if (endTime) {
        dtEnd = "DTEND:" + toIcsDateTime(dateParts, endTime);
      } else {
        // Default 1 hour
        var endH = { hours: startTime.hours + 1, minutes: startTime.minutes };
        dtEnd = "DTEND:" + toIcsDateTime(dateParts, endH);
      }
    } else {
      // All-day event
      dtStart = "DTSTART;VALUE=DATE:" + toIcsDateTime(dateParts, null);
      var nextDay = { year: dateParts.year, month: dateParts.month, day: dateParts.day + 1 };
      dtEnd = "DTEND;VALUE=DATE:" + toIcsDateTime(nextDay, null);
    }

    var desc = (event.content || "").replace(/\n/g, "\\n");
    var title = (event.title || "Evento").replace(/,/g, "\\,");

    var ics = [
      "BEGIN:VCALENDAR",
      "VERSION:2.0",
      "PRODID:-//PanelComunicacion//Calendar//ES",
      "CALSCALE:GREGORIAN",
      "METHOD:PUBLISH",
      "BEGIN:VEVENT",
      dtStart,
      dtEnd,
      "SUMMARY:" + title,
      "DESCRIPTION:" + desc,
      "STATUS:CONFIRMED",
      "BEGIN:VALARM",
      "TRIGGER:-PT30M",
      "ACTION:DISPLAY",
      "DESCRIPTION:Recordatorio: " + title,
      "END:VALARM",
      "END:VEVENT",
      "END:VCALENDAR"
    ].join("\r\n");

    var blob = new Blob([ics], { type: "text/calendar;charset=utf-8" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = (event.title || "evento").replace(/[^a-zA-Z0-9áéíóúñ ]/gi, "").replace(/\s+/g, "_") + ".ics";
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);

    closeCalendarDropdown();
  }

  function exportToGoogleCalendar(event) {
    var dateParts = getEventDateParts(event);
    var startTime = parseTimeStr(event.start_time);
    var endTime = parseTimeStr(event.end_time);

    var dates;
    if (startTime) {
      var dtStart = toIcsDateTime(dateParts, startTime);
      var dtEnd;
      if (endTime) {
        dtEnd = toIcsDateTime(dateParts, endTime);
      } else {
        dtEnd = toIcsDateTime(dateParts, { hours: startTime.hours + 1, minutes: startTime.minutes });
      }
      dates = dtStart + "/" + dtEnd;
    } else {
      var dateStr = toIcsDateTime(dateParts, null);
      dates = dateStr + "/" + dateStr;
    }

    var params = new URLSearchParams({
      action: "TEMPLATE",
      text: event.title || "Evento",
      dates: dates,
      details: event.content || "",
    });

    window.open("https://calendar.google.com/calendar/render?" + params.toString(), "_blank");
    closeCalendarDropdown();
  }

  function exportToOutlookWeb(event) {
    var dateParts = getEventDateParts(event);
    var startTime = parseTimeStr(event.start_time);
    var endTime = parseTimeStr(event.end_time);

    var startDt = toIsoDateTime(dateParts, startTime || { hours: 0, minutes: 0 });
    var endDt;
    if (endTime) {
      endDt = toIsoDateTime(dateParts, endTime);
    } else if (startTime) {
      endDt = toIsoDateTime(dateParts, { hours: startTime.hours + 1, minutes: startTime.minutes });
    } else {
      endDt = toIsoDateTime(dateParts, { hours: 23, minutes: 59 });
    }

    var params = new URLSearchParams({
      rru: "addevent",
      subject: event.title || "Evento",
      startdt: startDt,
      enddt: endDt,
      body: event.content || "",
      path: "/calendar/action/compose"
    });

    window.open("https://outlook.live.com/calendar/0/deeplink/compose?" + params.toString(), "_blank");
    closeCalendarDropdown();
  }

  function closeCalendarDropdown() {
    var dropdown = document.getElementById("calendarDropdown");
    var btnAddCal = document.getElementById("btnAddCalendar");
    if (dropdown) dropdown.classList.remove("active");
    if (btnAddCal) btnAddCal.classList.remove("active");
  }

  document.addEventListener("DOMContentLoaded", initCalendar);
</script>
