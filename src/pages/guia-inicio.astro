<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var siteUrl = 'https://home-page-ui.vercel.app';

    document.querySelectorAll('.copy-btn, .copy-url-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        navigator.clipboard.writeText(siteUrl).then(function() {
          var originalText = btn.innerHTML;
          btn.innerHTML = '<svg viewBox="0 0 24 24" style="width:14px;height:14px;fill:white"><path d="M9 16.2l-3.5-3.5L4.09 14.1 9 19 21 7l-1.41-1.41z"></path></svg> Copiado';
          btn.style.background = '#10b981';
          setTimeout(function() {
            btn.innerHTML = originalText;
            btn.style.background = '';
          }, 2000);
        });
      });
    });
  });
</script>
