# Environment Variables Configuration
# Copy this file to .env and update the values as needed

# Backend GraphQL URL - The real backend API endpoint
# This is used by the server-side proxy and for SSR data fetching
BACKEND_GRAPHQL_URL=https://marks-test.com/graphql

# Public GraphQL URL - The endpoint used by client-side JavaScript
# By default, this uses the local proxy at /api/graphql which forwards to BACKEND_GRAPHQL_URL
# You can also set this to the backend URL directly if CORS is properly configured
PUBLIC_GRAPHQL_URL=/api/graphql
